@@ -60,3 +60,25 @@ impl Session {
         }
     }
 }
+
+/// Skate's session marker as its quick menu (hold LB) shows it, after the
+/// last tick (overlay patch 0050).
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct MarkerHud {
+    /// LB is held.
+    pub visible: bool,
+    /// LB + d-pad down would place a marker here.
+    pub can_place: bool,
+    /// A marker is set and LB + d-pad up would return to it.
+    pub can_return: bool,
+    /// Return hold progress, 0..1.
+    pub progress: f32,
+}
+
+impl Session {
+    /// SkateV: the session marker's HUD state after the last `advance`.
+    pub fn marker_hud(&self) -> MarkerHud {
+        let (visible, can_place, can_return, progress) = self.markers.hud();
+        MarkerHud { visible, can_place, can_return, progress }
+    }
+}
diff --git a/crates/skate-host/src/session_marker/mod.rs b/crates/skate-host/src/session_marker/mod.rs
